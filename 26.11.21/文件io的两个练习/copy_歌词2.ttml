<p begin="0:09.242" end="0:13.442"><span begin="0:09.242" end="0:09.662">编</span><span begin="0:09.662" end="0:10.082">曲</span><span begin="0:10.083" end="0:10.503">：</span><span begin="0:10.503" end="0:10.923">侯</span><span begin="0:10.923" end="0:11.343">江</span><span begin="0:11.343" end="0:11.763">浩</span><span begin="0:11.763" end="0:12.183">/</span><span begin="0:12.183" end="0:12.603">关</span><span begin="0:12.603" end="0:13.023">天</span><span begin="0:13.023" end="0:13.443">天</span></p>
<p begin="0:13.443" end="0:19.532"><span begin="0:13.443" end="0:13.863">制</span><span begin="0:13.864" end="0:14.284">作</span><span begin="0:14.284" end="0:14.704">人</span><span begin="0:14.704" end="0:15.124">：</span><span begin="0:15.124" end="0:15.544">侯</span><span begin="0:15.544" end="0:15.964">江</span><span begin="0:15.964" end="0:16.384">浩</span><span begin="0:16.384" end="0:16.804">/</span><span begin="0:16.804" end="0:17.224">关</span><span begin="0:17.224" end="0:17.644">天</span><span begin="0:17.644" end="0:18.064">天</span><span begin="0:18.065" end="0:18.485">/</span><span begin="0:18.485" end="0:18.905">队</span><span begin="0:18.905" end="0:19.219">长</span><span begin="0:19.219" end="0:19.532">YoungCaptain</span></p>
<p begin="0:19.533" end="0:24.405"><span begin="0:19.533" end="0:19.701">你</span><span begin="0:19.701" end="0:19.933">和</span><span begin="0:19.933" end="0:20.141">他</span><span begin="0:20.141" end="0:20.901">呀 </span><span begin="0:20.901" end="0:21.069">好</span><span begin="0:21.069" end="0:21.293">像</span><span begin="0:21.293" end="0:21.893">也</span><span begin="0:21.893" end="0:22.070">忘</span><span begin="0:22.070" end="0:22.301">掉</span><span begin="0:22.301" end="0:22.981">了 </span><span begin="0:22.981" end="0:23.157">我</span><span begin="0:23.157" end="0:23.421">们</span><span begin="0:23.421" end="0:23.693">的</span><span begin="0:23.693" end="0:23.965">时</span><span begin="0:23.965" end="0:24.405">光</span><span ttm:role="x-roman">nǐ hé tā ya hǎo xiàng yě wàng diào le wǒ men de shí guāng</span></p>
<p begin="0:24.653" end="0:28.701"><span begin="0:24.653" end="0:24.822">任</span><span begin="0:24.822" end="0:25.021">微</span><span begin="0:25.021" end="0:25.653">风</span><span begin="0:25.653" end="0:25.829">轻</span><span begin="0:25.829" end="0:26.029">轻</span><span begin="0:26.029" end="0:26.701">的</span><span begin="0:26.701" end="0:26.925">吹</span><span begin="0:26.925" end="0:27.157">走</span><span begin="0:27.157" end="0:27.509">了</span><span begin="0:27.509" end="0:27.709">我</span><span begin="0:27.709" end="0:28.045">的</span><span begin="0:28.045" end="0:28.293">感</span><span begin="0:28.293" end="0:28.701">伤</span><span ttm:role="x-roman">rèn wēi fēng qīng qīng de chuī zǒu le wǒ de gǎn shāng</span></p>
<p begin="0:28.942" end="0:31.909"><span begin="0:28.942" end="0:29.143">我</span><span begin="0:29.143" end="0:29.398">没</span><span begin="0:29.398" end="0:29.615">办</span><span begin="0:29.615" end="0:31.199">法</span><span begin="0:31.199" end="0:31.375">陪</span><span begin="0:31.375" end="0:31.589">你</span><span begin="0:31.589" end="0:31.780">成</span><span begin="0:31.780" end="0:31.909">长</span><span ttm:role="x-roman">wǒ méi bàn fǎ péi nǐ chéng zhǎng</span></p>
<p begin="0:32.092" end="0:35.429"><span begin="0:32.092" end="0:32.301">只</span><span begin="0:32.301" end="0:32.589">能</span><span begin="0:32.589" end="0:32.876">在</span><span begin="0:32.876" end="0:33.204">窗</span><span begin="0:33.204" end="0:33.445">外</span><span begin="0:33.445" end="0:33.701">看</span><span begin="0:33.701" end="0:34.029">着</span><span begin="0:34.029" end="0:34.261">你</span><span begin="0:34.261" end="0:34.541">的</span><span begin="0:34.541" end="0:34.757">模</span><span begin="0:34.757" end="0:35.429">样</span><span ttm:role="x-roman">zhǐ néng zài chuāng wài kàn zhe nǐ de mó yàng</span></p>
<p begin="0:36.423" end="0:39.023"><span begin="0:36.423" end="0:36.687">这</span><span begin="0:36.687" end="0:36.880">些</span><span begin="0:36.880" end="0:37.024">年</span><span begin="0:37.024" end="0:37.199">你</span><span begin="0:37.199" end="0:37.448">换</span><span begin="0:37.448" end="0:37.592">了</span><span begin="0:37.592" end="0:37.777">又</span><span begin="0:37.777" end="0:38.343">换 </span><span begin="0:38.343" end="0:38.488">不</span><span begin="0:38.488" end="0:38.623">厌</span><span begin="0:38.623" end="0:38.800">其</span><span begin="0:38.800" end="0:39.023">烦</span><span ttm:role="x-roman">zhè xiē nián nǐ huàn le yòu huàn bù yàn qí fán</span></p>
<p begin="0:39.437" end="0:41.724"><span begin="0:39.437" end="0:39.588">也</span><span begin="0:39.588" end="0:39.740">许</span><span begin="0:39.740" end="0:39.940">你</span><span begin="0:39.940" end="0:40.077">只</span><span begin="0:40.077" end="0:40.301">是</span><span begin="0:40.301" end="0:40.453">孤</span><span begin="0:40.453" end="0:41.020">单 </span><span begin="0:41.020" end="0:41.148">兜</span><span begin="0:41.148" end="0:41.269">兜</span><span begin="0:41.269" end="0:41.540">转</span><span begin="0:41.540" end="0:41.724">转</span><span ttm:role="x-roman">yě xǔ nǐ zhǐ shì gū dān dōu dōu zhuǎn zhuǎn</span></p>
<p begin="0:42.136" end="0:43.689"><span begin="0:42.136" end="0:42.272">总</span><span begin="0:42.272" end="0:42.408">有</span><span begin="0:42.408" end="0:42.673">人</span><span begin="0:42.673" end="0:42.833">还</span><span begin="0:42.833" end="0:42.968">站</span><span begin="0:42.968" end="0:43.233">在</span><span begin="0:43.233" end="0:43.433">对</span><span begin="0:43.433" end="0:43.689">岸</span><span ttm:role="x-roman">zǒng yǒu rén hái zhàn zài duì àn</span></p>
<p begin="0:44.064" end="0:45.968"><span begin="0:44.064" end="0:44.241">灯</span><span begin="0:44.241" end="0:44.569">塔</span><span begin="0:44.569" end="0:44.729">的</span><span begin="0:44.729" end="0:44.881">光</span><span begin="0:44.881" end="0:45.048">在</span><span begin="0:45.048" end="0:45.169">那</span><span begin="0:45.169" end="0:45.384">里</span><span begin="0:45.384" end="0:45.617">旋</span><span begin="0:45.617" end="0:45.968">转</span><span ttm:role="x-roman">dēng tǎ de guāng zài nà lǐ xuán zhuǎn</span></p>
<p begin="0:46.256" end="0:48.169"><span begin="0:46.256" end="0:46.400">我</span><span begin="0:46.400" end="0:46.584">的</span><span begin="0:46.584" end="0:46.809">确</span><span begin="0:46.809" end="0:46.961">想</span><span begin="0:46.961" end="0:47.089">找</span><span begin="0:47.089" end="0:47.225">个</span><span begin="0:47.225" end="0:47.545">人</span><span begin="0:47.545" end="0:47.768">陪</span><span begin="0:47.768" end="0:48.169">伴</span><span ttm:role="x-roman">wǒ de què xiǎng zhǎo gè rén péi bàn</span></p>
<p begin="0:48.448" end="0:50.377"><span begin="0:48.448" end="0:48.601">但</span><span begin="0:48.601" end="0:48.744">除</span><span begin="0:48.744" end="0:48.977">了</span><span begin="0:48.977" end="0:49.441">你 </span><span begin="0:49.441" end="0:49.657">必</span><span begin="0:49.657" end="0:49.937">须</span><span begin="0:49.937" end="0:50.096">是</span><span begin="0:50.096" end="0:50.377">你</span><span ttm:role="x-roman">dàn chú le nǐ bì xū shì nǐ</span></p>
<p begin="0:50.781" end="0:53.149"><span begin="0:50.781" end="0:50.972">除</span><span begin="0:50.972" end="0:51.197">了</span><span begin="0:51.197" end="0:51.861">你</span><span begin="0:51.861" end="0:52.053">谁</span><span begin="0:52.053" end="0:52.188">都</span><span begin="0:52.188" end="0:52.493">不</span><span begin="0:52.493" end="0:52.725">可</span><span begin="0:52.725" end="0:53.149">以</span><span ttm:role="x-roman">chú le nǐ shéi dōu bù kě yǐ</span></p>
<p begin="0:53.528" end="0:56.297"><span begin="0:53.528" end="0:53.705">为</span><span begin="0:53.705" end="0:54.608">何</span><span begin="0:54.608" end="0:54.826">偏</span><span begin="0:54.826" end="0:55.648">偏</span><span begin="0:55.648" end="0:55.857">是</span><span begin="0:55.857" end="0:56.297">你</span><span ttm:role="x-roman">wèi hé piān piān shì nǐ</span></p>
<p begin="0:56.553" end="0:59.465"><span begin="0:56.553" end="0:56.737">算</span><span begin="0:56.737" end="0:56.960">了</span><span begin="0:56.960" end="0:57.176">就</span><span begin="0:57.176" end="0:57.497">让</span><span begin="0:57.497" end="0:57.761">我</span><span begin="0:57.761" end="0:58.073">自</span><span begin="0:58.073" end="0:58.344">己</span><span begin="0:58.344" end="0:58.600">忘</span><span begin="0:58.600" end="0:58.849">得</span><span begin="0:58.849" end="0:59.113">彻</span><span begin="0:59.113" end="0:59.465">底</span><span ttm:role="x-roman">suàn le jiù ràng wǒ zì jǐ wàng dé chè dǐ</span></p>
<p begin="0:59.470" end="1:01.632"><span begin="0:59.470" end="0:59.679">那</span><span begin="0:59.679" end="1:00.265">夜</span><span begin="1:00.265" end="1:00.473">细</span><span begin="1:00.473" end="1:01.073">雨</span><span begin="1:01.073" end="1:01.273">沥</span><span begin="1:01.273" end="1:01.632">沥</span><span ttm:role="x-roman">nà yè xì yǔ lì lì</span></p>
<p begin="1:01.913" end="1:04.808"><span begin="1:01.913" end="1:02.104">我</span><span begin="1:02.104" end="1:02.345">捧</span><span begin="1:02.345" end="1:02.577">着</span><span begin="1:02.577" end="1:02.840">你</span><span begin="1:02.840" end="1:03.153">手</span><span begin="1:03.153" end="1:03.393">一</span><span begin="1:03.393" end="1:03.737">起</span><span begin="1:03.737" end="1:04.008">裹</span><span begin="1:04.008" end="1:04.281">紧</span><span begin="1:04.281" end="1:04.504">风</span><span begin="1:04.504" end="1:04.808">衣</span><span ttm:role="x-roman">wǒ pěng zhe nǐ shǒu yī qǐ guǒ jǐn fēng yī</span></p>
<p begin="1:04.833" end="1:07.402"><span begin="1:04.833" end="1:05.056">接</span><span begin="1:05.056" end="1:05.313">过</span><span begin="1:05.313" end="1:05.561">你</span><span begin="1:05.561" end="1:05.816">杯</span><span begin="1:05.816" end="1:06.136">子</span><span begin="1:06.136" end="1:06.369">温</span><span begin="1:06.369" end="1:06.728">暖</span><span begin="1:06.728" end="1:06.969">的</span><span begin="1:06.969" end="1:07.201">唇</span><span begin="1:07.201" end="1:07.402">印</span><span ttm:role="x-roman">jiē guò nǐ bēi zǐ wēn nuǎn de chún yìn</span></p>
<p begin="1:07.585" end="1:09.706"><span begin="1:07.585" end="1:07.794">除</span><span begin="1:07.794" end="1:08.041">了</span><span begin="1:08.041" end="1:08.346">你</span><span begin="1:08.346" end="1:08.585">谁</span><span begin="1:08.585" end="1:08.865">都</span><span begin="1:08.865" end="1:09.138">不</span><span begin="1:09.138" end="1:09.377">可</span><span begin="1:09.377" end="1:09.706">以</span><span ttm:role="x-roman">chú le nǐ shéi dōu bù kě yǐ</span></p>
<p begin="1:10.211" end="1:13.723"><span begin="1:10.211" end="1:10.387">一</span><span begin="1:10.387" end="1:10.603">点</span><span begin="1:10.603" end="1:10.786">一</span><span begin="1:10.786" end="1:11.011">点</span><span begin="1:11.011" end="1:11.275">的</span><span begin="1:11.275" end="1:11.530">把</span><span begin="1:11.530" end="1:11.779">你</span><span begin="1:11.779" end="1:12.018">遗</span><span begin="1:12.018" end="1:12.674">忘 </span><span begin="1:12.674" end="1:12.954">我</span><span begin="1:12.954" end="1:13.210">也</span><span begin="1:13.210" end="1:13.426">不</span><span begin="1:13.426" end="1:13.723">想</span><span ttm:role="x-roman">yī diǎn yī diǎn de bǎ nǐ yí wàng wǒ yě bù xiǎng</span></p>
<p begin="1:13.922" end="1:17.794"><span begin="1:13.922" end="1:14.113">一</span><span begin="1:14.113" end="1:14.298">天</span><span begin="1:14.298" end="1:14.497">一</span><span begin="1:14.497" end="1:14.762">天 </span><span begin="1:14.762" end="1:15.041">的</span><span begin="1:15.041" end="1:15.305">胡</span><span begin="1:15.305" end="1:15.586">思</span><span begin="1:15.586" end="1:15.834">乱</span><span begin="1:15.834" end="1:16.522">想 </span><span begin="1:16.522" end="1:16.690">只</span><span begin="1:16.690" end="1:16.938">有</span><span begin="1:16.938" end="1:17.185">我</span><span begin="1:17.185" end="1:17.434">这</span><span begin="1:17.434" end="1:17.794">样</span><span ttm:role="x-roman">yī tiān yī tiān de hú sī luàn xiǎng zhǐ yǒu wǒ zhè yàng</span></p>
<p begin="1:18.114" end="1:21.666"><span begin="1:18.114" end="1:18.282">可</span><span begin="1:18.282" end="1:18.562">是</span><span begin="1:18.562" end="1:18.817">当</span><span begin="1:18.817" end="1:19.058">再</span><span begin="1:19.058" end="1:19.362">见 </span><span begin="1:19.362" end="1:19.610">我</span><span begin="1:19.610" end="1:19.882">还</span><span begin="1:19.882" end="1:20.146">是</span><span begin="1:20.146" end="1:20.426">会</span><span begin="1:20.426" end="1:20.729">热</span><span begin="1:20.729" end="1:21.002">泪</span><span begin="1:21.002" end="1:21.217">盈</span><span begin="1:21.217" end="1:21.666">眶</span><span ttm:role="x-roman">kě shì dāng zài jiàn wǒ hái shì huì rè lèi yíng kuàng</span></p>
<p begin="1:21.970" end="1:23.778"><span begin="1:21.970" end="1:22.137">因</span><span begin="1:22.137" end="1:22.322">为</span><span begin="1:22.322" end="1:22.610">你</span><span begin="1:22.610" end="1:22.866">的</span><span begin="1:22.866" end="1:23.362">模</span><span begin="1:23.362" end="1:23.778">样</span><span ttm:role="x-roman">yīn wèi nǐ de mó yàng</span></p>
